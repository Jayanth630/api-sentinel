# Environment Configuration for API Sentinel

# Flask Configuration
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=dev-secret-key-change-in-production-apisentinel-99

# Database Configuration
# Defaults to sqlite:///api_sentinel.db in instance/ directory
DATABASE_URL=sqlite:///instance/api_sentinel.db

# Monitoring Scheduler Configuration
# Background check loop interval in seconds (how often scheduler inspects endpoints)
SCHEDULER_INTERVAL_SECONDS=10
# Set to 1 or true to enable background scheduler
ENABLE_BACKGROUND_SCHEDULER=true

# Security Configuration
# Set to true only in development if you need to monitor localhost / local services
ALLOW_LOCAL_MONITORING=false

# Port for running the app
PORT=5000
HOST=0.0.0.0
